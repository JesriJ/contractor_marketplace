generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String
  role              UserRole
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  contractorProfile ContractorProfile?
  conversations     Conversation[]
  hireRequests      HireRequest[]
  jobs              Job[]
  messages          Message[]
  payments          Payment[]
  reviews           Review[]
}

model ContractorProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  companyName     String
  trade           String
  bio             String
  hourlyRate      Decimal        @db.Decimal(8, 2)
  yearsExperience Int
  city            String
  state           String
  profileImage    String?
  verified        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  bids            Bid[]
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations   Conversation[]
  hireRequests    HireRequest[]
  assignedJobs    Job[]
  payments        Payment[]
  reviews         Review[]

  @@index([trade])
  @@index([city])
  @@index([state])
}

model Job {
  id           String             @id @default(cuid())
  title        String
  description  String
  budget       Decimal?           @db.Decimal(10, 2)
  location     String
  status       JobStatus          @default(OPEN)
  customerId   String
  contractorId String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  bids         Bid[]
  conversation Conversation?
  hireRequest  HireRequest?
  contractor   ContractorProfile? @relation(fields: [contractorId], references: [id])
  customer     User               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payment      Payment?
  review       Review?

  @@index([status])
  @@index([customerId])
  @@index([contractorId])
}

model Bid {
  id                String            @id @default(cuid())
  jobId             String
  contractorId      String
  amount            Decimal           @db.Decimal(10, 2)
  message           String
  estimatedDuration String
  status            BidStatus         @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  contractor        ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  job               Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, contractorId])
  @@index([contractorId])
}

model HireRequest {
  id           String            @id @default(cuid())
  customerId   String
  contractorId String
  message      String
  status       HireRequestStatus @default(PENDING)
  jobId        String?           @unique
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  contractor   ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  customer     User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job          Job?              @relation(fields: [jobId], references: [id])

  @@index([customerId])
  @@index([contractorId])
  @@index([status])
}

model Conversation {
  id                   String            @id @default(cuid())
  customerId           String
  contractorId         String
  jobId                String            @unique
  customerLastReadAt   DateTime?
  contractorLastReadAt DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  contractor           ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  customer             User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job                  Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages             Message[]

  @@index([customerId])
  @@index([contractorId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Review {
  id           String            @id @default(cuid())
  jobId        String            @unique
  customerId   String
  contractorId String
  rating       Int
  comment      String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  contractor   ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  customer     User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job          Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([contractorId])
}

model Payment {
  id                      String            @id @default(cuid())
  jobId                   String            @unique
  customerId              String
  contractorId            String
  amount                  Decimal           @db.Decimal(10, 2)
  currency                String            @default("usd")
  status                  PaymentStatus     @default(PENDING)
  stripeCheckoutSessionId String?           @unique
  stripePaymentIntentId   String?           @unique
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  contractor              ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  customer                User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job                     Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model StripeWebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

enum UserRole {
  CUSTOMER
  CONTRACTOR
}

enum JobStatus {
  OPEN
  BIDDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  PENDING_CONFIRMATION
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum HireRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}
