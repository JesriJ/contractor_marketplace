# Local PostgreSQL (default port 5432)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/contractor_marketplace"

# Docker Compose PostgreSQL from this repo (port 5433)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/contractor_marketplace"

NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Stripe test mode only. Do not put live secret keys here.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Optional. Checkout does not send this key to the browser.
STRIPE_PUBLISHABLE_KEY="pk_test_..."
